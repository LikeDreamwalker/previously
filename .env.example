# DeepSeek API key
DEEPSEEK_API_KEY=sk-...

# Storage backend: local | github | demo
# When unset, auto-detects: GITHUB_TOKEN present → github, dev → local, else demo
STORAGE=local

# Deployment mode: cloud (default) | client
# In client mode the datasource auto-detect default is always "local".
# PREVIOUSLY_MODE=client

# Absolute path to the memory data root (local storage only). When set,
# whitelisted memory/ paths resolve against this directory instead of the
# repo's own memory/. Unset = byte-identical to previous behavior.
# MEMORY_ROOT=/absolute/path/to/memory

# Subscription bridge command (client mode only) — the delegateTask tool
# spawns this command, passes the task payload ({task, context}) as JSON on
# stdin, and returns its stdout as the result. Spawned directly (no shell);
# quote paths containing spaces.
# PREVIOUSLY_BRIDGE_CMD=previously bridge-exec

# Bridge execution timeout in milliseconds (client mode only, default 600000).
# PREVIOUSLY_BRIDGE_TIMEOUT_MS=600000

# GitHub fine-grained PAT (contents read/write, single repo)
GITHUB_TOKEN=github_pat_...

# GitHub repository info (used by file tools)
GITHUB_REPO_OWNER=previously-lab
GITHUB_REPO_NAME=agent

# Demo data URL (only used when STORAGE=demo or auto-detected as demo)
# BENCHMARK_BASE_URL=https://raw.githubusercontent.com/previously-lab/benchmark-data/main

# Demo-mode model lock (optional, PUBLIC demo deployments only). When the data
# source resolves to demo AND DEMO_LOCK=1, the chat model and thinking
# intensity are pinned server-side so visitors can't drive up token spend on
# the maintainer's key. Self-hosted deployments that happen to run on the demo
# data source should leave DEMO_LOCK unset — their own key, their own choice.
# Defaults: deepseek-v4-flash-vision-exp @ low effort, thinking on.
# DEMO_LOCK=1
# DEMO_MODEL=deepseek-v4-flash-vision-exp
# DEMO_EFFORT=low

# Access key for non-browser callers (optional)
# When set, non-browser callers of POST /api/chat, /api/episodic/flush
# must send an `x-access-key` header with this value. Same-origin browser calls
# always pass. Leave unset to keep a private deployment frictionless.
# ACCESS_SECRET=
